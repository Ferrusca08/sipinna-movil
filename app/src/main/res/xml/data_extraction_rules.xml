<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Los tokens de seguimiento no salen del dispositivo por respaldo. -->
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
