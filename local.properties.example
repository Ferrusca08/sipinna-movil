# Copia este archivo como local.properties y llena los valores.
# local.properties NO debe subirse al control de versiones.

# Ruta del SDK de Android (la escribe Android Studio automáticamente).
sdk.dir=/Users/TU_USUARIO/Library/Android/sdk

# URL del API que imprime `terraform output api_endpoint`.
API_BASE_URL=https://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com

# Llave de Google Maps SDK for Android (consola de Google Cloud).
MAPS_API_KEY=AIza...
